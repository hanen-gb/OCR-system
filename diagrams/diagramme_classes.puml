@startuml diagramme_classes
skinparam backgroundColor         #F8FAFC
skinparam classBackgroundColor    #EEF2FF
skinparam classBorderColor        #4F46E5
skinparam classHeaderBackgroundColor #4F46E5
skinparam classAttributeFontColor #1E1B4B
skinparam ArrowColor              #4F46E5
skinparam ArrowFontColor          #4F46E5
skinparam ArrowFontSize           11
skinparam stereotypeCBackgroundColor #DBEAFE
skinparam stereotypeABackgroundColor #FCE7F3
skinparam stereotypeEBackgroundColor #DCFCE7
skinparam noteBorderColor         #94A3B8
skinparam noteBackgroundColor     #F8FAFC
skinparam linetype ortho

' ══════════════════════════════════════════════════
'  ÉNUMÉRATIONS
' ══════════════════════════════════════════════════

enum DocType {
  FACTURE
  TRAITE
}

enum DocStatus {
  PROCESSING
  PENDING
  VALIDATED
}

' ══════════════════════════════════════════════════
'  MODÈLE DE DONNÉES (PostgreSQL)
' ══════════════════════════════════════════════════

abstract class Document {
  +id           : int
  +filename     : str
  +doc_type     : DocType
  +status       : DocStatus
  +audit_status : str
  +created_at   : datetime
}

class Facture {
  +numero      : str
  +date        : date
  +fournisseur : str
  +client      : str
  +montant_ttc : float
  +notes_agent : JSON
}

class Traite {
  +numero        : str
  +date_echeance : date
  +tireur        : str
  +tire          : str
  +rib           : str
  +domiciliation : str
  +montant       : float
  +notes_agent   : JSON
}

' ══════════════════════════════════════════════════
'  MODÈLE GLM-OCR (Modal GPU)
' ══════════════════════════════════════════════════

class Entity {
  +label : str
  +text  : str
}

class PredictResult {
  +entities                  : Entity[]
  +full_text                 : str
  +doc_type                  : str
  +classification_confidence : float
  +timing                    : dict
}

class GLMModel {
  +model_facture : HF_Repo
  +model_traite  : HF_Repo
  +classifier    : MobileNet
  --
  +predict(image) : PredictResult
}

' ══════════════════════════════════════════════════
'  AGENTS LANGGRAPH (LangGraph multi-agent)
' ══════════════════════════════════════════════════

abstract class Agent {
  +name : str
  --
  +run(state) : State
}

class AgentExtracteur {
  +detect_file_type()
  +extract_text()
  +extract_augmented_entities()
  +merge_entities()
}

class AgentAuditeur {
  +check_arithmetic()
  +check_tva()
  +check_net_a_payer()
  +check_doublon()
  +check_gouvernance()
  +normalize_amount()
}

class AgentAnalyste {
  +load_history()
  +compute_stats()
  +detect_anomalies()
  +generate_insights()
}

class AgentChatbot {
  +understand_intent()
  +query_db()
  +generate_response()
}

' ══════════════════════════════════════════════════
'  RAPPORTS DE SORTIE
' ══════════════════════════════════════════════════

class AuditReport {
  +status_validite            : str
  +nb_erreurs_calcul          : int
  +validation_tva_globale     : dict
  +conformite_net_a_payer     : dict
  +alerte_doublon             : dict
  +gouvernance                : dict
}

class AnalystReport {
  +alert_level       : str
  +nb_anomalies      : int
  +anomalies         : List[dict]
  +stats_fournisseur : dict
  +insights          : str
}

' ══════════════════════════════════════════════════
'  SERVICES
' ══════════════════════════════════════════════════

class NotificationService {
  +ALERT_EMAIL_TO    : str
  +GMAIL_SENDER      : str
  --
  +check_alert_conditions()
  +send_alert_email()
}

class SQLiteDB {
  +db_path : str
  --
  +check_doublon(doc_number) : bool
  +register_document()
}

class PostgreSQLDB {
  +DATABASE_URL : str
  --
  +save_document()
  +get_documents()
  +get_facture(doc_id)
  +get_traite(doc_id)
}

' ══════════════════════════════════════════════════
'  RELATIONS
' ══════════════════════════════════════════════════

' Héritage données
Document    <|--  Facture
Document    <|--  Traite
Document    -->   DocType
Document    -->   DocStatus

' Héritage agents
Agent       <|--  AgentExtracteur
Agent       <|--  AgentAuditeur
Agent       <|--  AgentAnalyste
Agent       <|--  AgentChatbot

' GLM
GLMModel    ..>   PredictResult   : <<create>>
PredictResult "1" *-- "n" Entity

' Agent 1
AgentExtracteur ..> PredictResult  : utilise

' Agent 2
AgentAuditeur   ..>  AuditReport         : <<produce>>
AgentAuditeur   -->  NotificationService : déclenche
AgentAuditeur   -->  SQLiteDB            : vérifie doublon

' Agent 3
AgentAnalyste   ..>  AnalystReport  : <<produce>>
AgentAnalyste   -->  PostgreSQLDB   : lit historique

' Persistance
PostgreSQLDB    -->  Document

@enduml
