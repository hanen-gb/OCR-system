# Agents backend (assistant/) — copy to assistant/.env and fill in the values.
# Never commit the real .env file.

# ── LLM providers ────────────────────────────────────────────────────────────
GROQ_API_KEY=                 # extraction (qwen3-32b), vision fallback, chatbot
GOOGLE_API_KEY=               # Gemini fallback (text and vision)
HF_API_KEY_2=                 # Hugging Face Inference API (text fallback)
OPENAI_API_KEY=               # optional
OCR_SPACE_API_KEY=            # OCR.space REST OCR (free tier available)

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/odsinet_db

# ── API security ─────────────────────────────────────────────────────────────
JWT_SECRET=                   # long random string

# ── E-mail alerts (Auditor / Analyst agents) ────────────────────────────────
GMAIL_SENDER=
GMAIL_APP_PASSWORD=           # Gmail application password, not the account password
ALERT_EMAIL_TO=

# ── Alert thresholds (Tunisian dinars) ───────────────────────────────────────
ALERT_THRESHOLD_DT=5000
ALERT_NOUVEAU_MONTANT_DT=4000
ALERT_MONTANT_RATIO=3.0
ALERT_DEADLINE_DAYS=2
